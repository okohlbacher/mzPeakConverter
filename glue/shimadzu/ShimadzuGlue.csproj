<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShimadzuGlue — a thin C# shim the Rust `shimadzu` path hosts in-process (via netcorehost)
    to read Shimadzu LabSolutions .lcd files through the vendor Shimadzu.LabSolutions.IO managed
    API (the same DLL ProteoWizard's Reader_Shimadzu wraps).

    KEY DESIGN POINT: NO <Reference>/<PackageReference> to any Shimadzu assembly. The vendor DLL
    (Shimadzu.LabSolutions.IO.IoModule.dll) is loaded at RUNTIME via System.Reflection
    (Assembly.LoadFrom + late-bound member invocation), so this project `dotnet build`s on any
    platform WITHOUT the vendor DLL — the build host has none; the runtime host (Windows) supplies
    it out of a ProteoWizard install (flat in pwiz-bin, next to msconvert.exe).

    ⚠️ WINDOWS-RUNTIME-ONLY. The Shimadzu DLL is managed .NET over native/COM: it only *runs* on
       Windows with .NET. It also carries a restrictive Shimadzu EULA (ProteoWizard-branded scope,
       no reverse-engineering) — see README.md.

    Build:  dotnet build -c Release
    Output: bin/Release/net8.0/ShimadzuGlue.dll (+ ShimadzuGlue.runtimeconfig.json)
    Then point the Rust env var MZPC_SHIMADZU_GLUE at that directory.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShimadzuGlue</AssemblyName>
    <RootNamespace>ShimadzuGlue</RootNamespace>
    <OutputType>Library</OutputType>
    <!-- netcorehost boots the runtime via initialize_for_runtime_config; EnableDynamicLoading
         emits the required ShimadzuGlue.runtimeconfig.json next to the DLL. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 64-bit only: the Shimadzu native bits are x64. -->
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shimadzu.LabSolutions.IO 5.0.0.0 (the version ProteoWizard 3.0.26151+ ships) deserializes
         part of the .lcd through BinaryFormatter, which .NET disables by default since .NET 5:
         `LoadData` then throws NotSupportedException wrapped in a TargetInvocationException and the
         file looks unreadable. The 3.8.4 DLL did not need it.

         This matters far beyond loading: 3.8.4 returns centroid intensities MISALIGNED against
         their m/z on profile-less .lcd files (shifted 1-7 positions, last peak dropped) — the
         long-standing "vendor defect". 5.0.0.0 returns them CORRECTLY: measured on
         DIA_Hela_20ng.lcd, msconvert driving 5.0.0.0 reproduces the LabSolutions export exactly
         (612/14,300/13,558/11,361 peaks, max |dintensity| = 0), where 3.8.4 gives n-1 and the
         rotation. So enabling this switch is what lets the native lane read those files correctly.

         SECURITY: BinaryFormatter is disabled by default because deserializing UNTRUSTED input is
         unsafe. The input here is a vendor instrument file the user chose to convert, and the same
         code path is what ProteoWizard itself runs. Do not widen this to other inputs. Note .NET 9
         REMOVES BinaryFormatter outright, so a future retarget needs Shimadzu to ship a DLL that
         does not use it. -->
    <RuntimeHostConfigurationOption
      Include="System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization"
      Value="true" Trim="false" />
  </ItemGroup>

</Project>
